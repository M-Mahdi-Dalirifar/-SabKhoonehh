# Supabase browser configuration
# The anon key is intended for client-side use. Protect data with Supabase Row Level Security.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Gemini API access
GEMINI_API_KEY="your_gemini_api_key"

# Public application URL, used where callbacks or self-referential links are needed.
APP_URL="http://localhost:3000"
